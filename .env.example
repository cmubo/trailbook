# Public Supabase API URL.
# Local: http://127.0.0.1:54321
# Production: the project URL from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key used in the browser. Row Level Security still applies.
# Local: shown by `npx supabase status` as the publishable or anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never prefix this with NEXT_PUBLIC_.
# Used only for narrow admin operations such as sending an invitation.
SUPABASE_SECRET_KEY=

# Public origin of this Next.js app, used when building auth redirect URLs.
# Local: http://localhost:3000
# Production: the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=

# Secret path segment for /admin/<OWNER_ROUTE_SECRET>.
# This hides the admin address. It does not grant owner privileges.
# Generate one with: openssl rand -hex 32
# Never prefix this with NEXT_PUBLIC_.
OWNER_ROUTE_SECRET=
